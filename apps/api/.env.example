NODE_ENV=development
PORT=3001
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://catalog:catalog_local@localhost:5433/catalog?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=10000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
SWAGGER_ENABLED=true
FRESHNESS_AGING_HOURS=72
FRESHNESS_STALE_HOURS=168
ADMIN_API_KEY=replace-with-at-least-32-random-characters
ADMIN_AUTH_MODE=local-key
# Enable only after applying/reviewing the merchant access migration and tests.
MERCHANT_ACCESS_ENABLED=false
# Enable only after the product-review migration and compatible admin rollout.
PRODUCT_REVIEWS_ENABLED=false
# Production requires ADMIN_AUTH_MODE=firebase and FIREBASE_PROJECT_ID.
# FIREBASE_PROJECT_ID=achaaqui-web
# Never configure FIREBASE_AUTH_EMULATOR_HOST in production.
ANALYTICS_HASH_KEY=replace-with-at-least-32-random-characters
ANALYTICS_RETENTION_DAYS=90
IMPORT_SUPPORTED_CURRENCIES=BRL,USD,PYG
IMPORT_SUSPICIOUS_CHANGE_PERCENT=50
IMPORT_MAX_ROWS=500
IMPORT_MAX_FILE_BYTES=2097152
PHOTO_IMPORT_ENABLED=false
# Backend only. Store in Secret Manager for an approved rollout, never EXPO_PUBLIC_.
MISTRAL_API_KEY=

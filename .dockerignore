# Runtime/migration builds need only this allowlisted source, never local secrets.
**
!package.json
!package-lock.json
!apps/
!apps/api/
!apps/api/package.json
!apps/api/nest-cli.json
!apps/api/tsconfig*.json
!apps/api/prisma.config.ts
!apps/api/prisma/
!apps/api/prisma/**
!apps/api/src/
!apps/api/src/**
apps/api/src/generated/
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.log
**/.DS_Store
**/node_modules/
